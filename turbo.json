{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate:codama-idl": {
      "outputs": ["idl/codama.json"]
    },
    "generate:clients": {
      "dependsOn": ["generate:codama-idl"],
      "outputs": ["clients/ts/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:fix": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"]
    }
  }
}
