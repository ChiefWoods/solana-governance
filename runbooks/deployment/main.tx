################################################################
# Manage program deployment through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_ncn_program" "svm::deploy_program" {
    description = "Deploy ncn_snapshot program"
    program = svm::get_program_from_anchor_project(
        "ncn_snapshot", 
        "target/deploy/ncn_snapshot-keypair.json",
        "target/idl/ncn_snapshot.json",
        "target/deploy/ncn_snapshot.so"
    ) 
    authority = signer.authority
    payer = signer.payer
}


action "deploy_svmgov" "svm::deploy_program" {
    description = "Deploy svmgov program"
    program = svm::get_program_from_anchor_project(
        "svmgov", 
        "target/deploy/svmgov-keypair.json",
        "target/idl/svmgov.json",
        "target/deploy/svmgov.so"
    ) 
    authority = signer.authority
    payer = signer.payer
}
