{
    "name": "@solana/ncn-verifier-service",
    "version": "0.1.0",
    "description": "TypeScript client for the Solana NCN verifier service",
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "format": "oxfmt --check",
        "format:fix": "oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
